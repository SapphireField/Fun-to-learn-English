{
  "name": "mellom-language-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily practice for precise English and Norwegian, with no frontend dependencies.",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local server.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --static",
    "preview": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local server.mjs --production",
    "test": "node --test tests/*.test.mjs"
  }
}
